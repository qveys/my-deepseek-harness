# Copy to .env (git-ignored) and fill in the values. Docker Compose reads the
# repository's .env automatically; the values stay outside the image.

# Required for model calls; read from the shell or .env by both Compose files.
DEEPSEEK_API_KEY=

# Optional API endpoint override.
DEEPSEEK_BASE_URL=

# Optional GitHub token for gh and git over HTTPS inside the container
# (docker-compose.dokploy.yml). A fine-grained token scoped to the needed repos.
GH_TOKEN=

# Optional absolute path to a host checkout to mount at /workspace. The container
# user (UID 1000) needs write access. Without it, Compose uses a named volume.
DSH_WORKSPACE=

# Optional host loopback port for the Web UI. Defaults to 3080; do not use 3081,
# which the relay reserves.
DSH_PORT=

# Required only by docker-compose.dokploy.yml: the authority Traefik serves, with
# no scheme, e.g. dsh.example.com. The browser's Host header must match it.
DSH_PUBLIC_HOST=
